<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode. -->
    <style name="Base.Theme.JobsApplicationTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/red_primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/red_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>

        <!-- Material 3 Surface roles for Dark Mode -->
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        <item name="colorOutline">#938F99</item>
        <item name="colorOutlineVariant">#444746</item>
    </style>
</resources>